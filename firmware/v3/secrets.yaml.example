# Copy to secrets.yaml and fill in.
# The networks this unit joins on its own. Leave the ssids empty and the
# device asks its owner for Wi-Fi instead, over the Home Assistant app
# (Bluetooth) or its own Hydrohomie access point.
wifi_ssid: ""
wifi_ssid_main: ""
wifi_password: ""
